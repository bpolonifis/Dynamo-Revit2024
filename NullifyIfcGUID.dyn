    },
    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "eb317841f9894952aae376932b0177f6",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "f81a68e5a2e74817b568caab696ccbd4",
          "Name": "element",
          "Description": "Revit.Elements.Element",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "2d6c30a759fd4c70bcc3ee518c8c01b8",
          "Name": "string",
          "Description": "string",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Revit.Elements.Element.UniqueId",
      "Replication": "Auto",
      "Description": "Get the Element Unique Id for this element\n\nElement.UniqueId: string"
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\n\r\n# Boilerplate imports\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nimport uuid\r\n\r\n\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\n# Inputs: 'IN[0]' = list of Elements\r\nelements = IN[0]\r\n# Place your code below this line\r\n\r\ndoc = __revit__.ActiveUIDocument.Document\r\n\r\nt = Transaction(doc, 'Randomize UniqueId + Prep IFC GUID')\r\nt.Start()\r\n\r\nresults = []\r\nfor el in elements:\r\n    if el.Id.IntegerValue > 0:\r\n        # Log old\r\n        old_uid = el.UniqueId\r\n        old_ifc = el.LookupParameter('IfcGUID')  # Clear cached if exists\r\n        if old_ifc: old_ifc.Set('')\r\n\r\n        # Regen UniqueId → triggers new IFC GUID on export\r\n        el.RegenerateUniqueId()\r\n        \r\n        # Optional: Force fully random UniqueId (overkill)\r\n        # new_uid = str(uuid.uuid4())\r\n        # el.SetUniqueId(new_uid)  # API may not support direct set\r\n        \r\n        results.append({\r\n            'old_uid': old_uid[:8],  # Trunc for display\r\n            'new_uid': el.UniqueId[:8]\r\n        })\r\n\r\nt.Commit()\r\nOUT = ['IFC GUIDs will be new on next export. Processed: {}'.format(len(results))]\r\n\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "9f6264b2e7754e4ebef264f37edf52f3",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "50aff4e89eb24eb19b0c85fd6ac2dc13",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "4f9e9b8577804eeda4cd35afc290247f",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
