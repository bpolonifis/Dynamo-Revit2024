  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nclr.AddReference('RevitNodes')\r\nclr.AddReference('ProtoGeometry')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom Autodesk.DesignScript.Geometry import *\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# Place your code below this line\r\n\r\n\r\nelements = UnwrapElement(IN[0])\r\n\r\nif not elements or len(elements) < 2:\r\n    OUT = \"Please provide at least 2 elements.\"\r\nelse:\r\n\r\n    centers = []\r\n\r\n    # Get center point of each element\r\n    for el in elements:\r\n        bbox = el.get_BoundingBox(None)\r\n\r\n        if bbox:\r\n            minPt = bbox.Min\r\n            maxPt = bbox.Max\r\n\r\n            center = XYZ(\r\n                (minPt.X + maxPt.X) / 2.0,\r\n                (minPt.Y + maxPt.Y) / 2.0,\r\n                (minPt.Z + maxPt.Z) / 2.0\r\n            )\r\n\r\n            centers.append(center)\r\n\r\n    if len(centers) >= 2:\r\n\r\n        # First point\r\n        firstPoint = centers[0]\r\n\r\n        # Last point\r\n        lastPoint = centers[-1]\r\n\r\n        # Overall centroid of all points\r\n        sumX = sum([pt.X for pt in centers])\r\n        sumY = sum([pt.Y for pt in centers])\r\n        sumZ = sum([pt.Z for pt in centers])\r\n\r\n        count = len(centers)\r\n\r\n        centroid = XYZ(\r\n            sumX / count,\r\n            sumY / count,\r\n            sumZ / count\r\n        )\r\n\r\n        # Output:\r\n        # [First Point, Last Point, Overall Centroid]\r\n        OUT = [\r\n            firstPoint.ToPoint(),\r\n            lastPoint.ToPoint(),\r\n            centroid.ToPoint()\r\n        ]\r\n\r\n    else:\r\n        OUT = \"Could not determine valid element centers.\"\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "26566c45b9ca467881cc5b09582b4466",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "d630a0c9def44684a37061e8e9552522",
