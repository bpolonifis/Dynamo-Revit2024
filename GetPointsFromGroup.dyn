    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# Load the Python Standard and DesignScript Libraries\r\nimport sys\r\nimport clr\r\nclr.AddReference('ProtoGeometry')\r\nclr.AddReference('RevitAPI')\r\nclr.AddReference('RevitServices')\r\nclr.AddReference('RevitNodes')\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.DesignScript.Geometry import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\n\r\n# The inputs to this node will be stored as a list in the IN variables.\r\ndataEnteringNode = IN\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n\r\n# Inputs\r\np1 = IN[0].ToXyz()\r\np2 = IN[1].ToXyz()\r\nwidth = IN[2]\r\nheight = IN[3]\r\ndepth = IN[4]\r\nsectionName = IN[5]\r\n\r\n# Place your code below this line\r\n\r\n\r\n# -------------------------\r\n# FIXED VECTOR OPERATIONS\r\n# -------------------------\r\n\r\n# Midpoint (manual XYZ math)\r\nmid = XYZ(\r\n    (p1.X + p2.X) * 0.5,\r\n    (p1.Y + p2.Y) * 0.5,\r\n    (p1.Z + p2.Z) * 0.5\r\n)\r\n\r\n# Direction from p1 to p2\r\nviewDir = XYZ(\r\n    p2.X - p1.X,\r\n    p2.Y - p1.Y,\r\n    p2.Z - p1.Z\r\n).Normalize()\r\n\r\n# Up vector\r\nup = XYZ.BasisZ\r\n\r\n# Right vector\r\nright = up.CrossProduct(viewDir).Normalize()\r\n\r\n# Transform\r\ntransform = Transform.Identity\r\ntransform.Origin = mid\r\ntransform.BasisX = right      # Width\r\ntransform.BasisY = up         # Height\r\ntransform.BasisZ = viewDir    # Depth\r\n\r\n# Bounding box\r\nbbox = BoundingBoxXYZ()\r\nbbox.Transform = transform\r\n\r\nhalfWidth = width / 2.0\r\nhalfHeight = height / 2.0\r\n\r\nbbox.Min = XYZ(-halfWidth, -halfHeight, 0)\r\nbbox.Max = XYZ(halfWidth, halfHeight, depth)\r\n\r\n# Get section type\r\nsectionType = None\r\ncollector = FilteredElementCollector(doc).OfClass(ViewFamilyType)\r\n\r\nfor vft in collector:\r\n    if vft.ViewFamily == ViewFamily.Section:\r\n        sectionType = vft\r\n        break\r\n\r\nif sectionType is None:\r\n    OUT = \"No section view type found.\"\r\nelse:\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    section = ViewSection.CreateSection(\r\n        doc,\r\n        sectionType.Id,\r\n        bbox\r\n    )\r\n\r\n    try:\r\n        section.Name = sectionName\r\n    except:\r\n        pass\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    OUT = section\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1ee2b86413b9433498214474f81b3c2a",
      "NodeType": "PythonScriptNode",
