  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Windows.Forms import MessageBox, MessageBoxButtons, MessageBoxIcon\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n\r\ntry:\r\n\r\n    # ========================================================\r\n    # 1. MODEL SIZE\r\n    # ========================================================\r\n\r\n    file_path = doc.PathName\r\n\r\n    if file_path and file_path != \"\" and file_path != \"<Internal>\":\r\n        file_size_mb = os.path.getsize(file_path) / (1024 * 1024)\r\n        model_size = str(round(file_size_mb, 2)) + \" MB\"\r\n    else:\r\n        model_size = \"Document not saved\"\r\n\r\n\r\n\r\n    # ========================================================\r\n    # 7. EXECUTE REVIT'S ACTUAL \"SELECT ALL\" COMMAND\r\n    # ========================================================\r\n\r\n    select_all_command_id = ( IN[0])\r\n       \r\n\r\n    if select_all_command_id is None:\r\n        raise Exception(\r\n            \"Could not find Revit Select All command.\"\r\n        )\r\n\r\n    if not uidoc.CanPostCommand(select_all_command_id):\r\n        raise Exception(\r\n            \"Revit Select All command cannot currently be executed.\"\r\n        )\r\n\r\n    uidoc.Application.PostCommand(\r\n        select_all_command_id\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # IMPORTANT\r\n    #\r\n    # PostCommand is asynchronous.\r\n    #\r\n    # The command is posted to Revit's UI queue and therefore\r\n    # the selection is NOT necessarily available immediately\r\n    # on the next line.\r\n    # ========================================================\r\n\r\n\r\n    # ========================================================\r\n    # 8. READ THE RESULTING REVIT SELECTION\r\n    # ========================================================\r\n\r\n    selected_ids = uidoc.Selection.GetElementIds()\r\n\r\n    element_count = selected_ids.Count\r\n\r\n    model_elements = (\r\n        str(element_count)\r\n        + \" elements\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # 9. MODEL WARNINGS\r\n    # ========================================================\r\n\r\n    warning_count = len(\r\n        doc.GetWarnings()\r\n    )\r\n\r\n    model_warnings = (\r\n        str(warning_count)\r\n        + \" warnings\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # 10. LOADED REVIT LINKS\r\n    # ========================================================\r\n\r\n    link_count = FilteredElementCollector(doc) \\\r\n        .OfClass(RevitLinkInstance) \\\r\n        .GetElementCount()\r\n\r\n    loaded_links = (\r\n        str(link_count)\r\n        + \" links\"\r\n    )\r\n\r\n\r\n    # ========================================================\r\n    # 11. PROJECT INFORMATION\r\n    # ========================================================\r\n\r\n    pi = FilteredElementCollector(doc) \\\r\n        .OfCategory(\r\n            BuiltInCategory.OST_ProjectInformation\r\n        ) \\\r\n        .FirstElement()\r\n\r\n\r\n    if pi is None:\r\n\r\n        OUT = \"Project Information element not found.\"\r\n\r\n    else:\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n        results = []\r\n\r\n        parameters_to_write = [\r\n            (\"Model Size\", model_size),\r\n            (\"Model Elements\", model_elements),\r\n            (\"Model Warnings\", model_warnings),\r\n            (\"Loaded Links\", loaded_links)\r\n        ]\r\n\r\n        for pname, pvalue in parameters_to_write:\r\n\r\n            p = pi.LookupParameter(pname)\r\n\r\n            if p and not p.IsReadOnly:\r\n\r\n                try:\r\n\r\n                    ok = p.Set(pvalue)\r\n\r\n                    results.append(\r\n                        pname\r\n                        + \": \"\r\n                        + str(ok)\r\n                    )\r\n\r\n                except Exception as parameter_error:\r\n\r\n                    results.append(\r\n                        pname\r\n                        + \": ERROR - \"\r\n                        + str(parameter_error)\r\n                    )\r\n\r\n            else:\r\n\r\n                results.append(\r\n                    pname\r\n                    + \": not found or read-only\"\r\n                )\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\n        # ====================================================\r\n        # 12. MESSAGE\r\n        # ====================================================\r\n\r\n        message = (\r\n            \"MODEL STATISTICS\\n\\n\"\r\n            + \"3D View:         \"\r\n            + three_d_view.Name\r\n            + \"\\n\"\r\n            + \"Model Size:      \"\r\n            + model_size\r\n            + \"\\n\"\r\n            + \"Model Elements:  \"\r\n            + model_elements\r\n            + \"\\n\"\r\n            + \"Model Warnings:  \"\r\n            + model_warnings\r\n            + \"\\n\"\r\n            + \"Loaded Links:    \"\r\n            + loaded_links\r\n            + \"\\n\\n\"\r\n            + \"Selection:\\n\"\r\n            + \"Revit Select All command executed.\"\r\n            + \"\\n\"\r\n            + \"Selected elements: \"\r\n            + str(element_count)\r\n            + \"\\n\\n\"\r\n            + \"Write results:\\n\"\r\n            + \"\\n\".join(results)\r\n        )\r\n\r\n\r\n        MessageBox.Show(\r\n            message,\r\n            \"Model Statistics\",\r\n            MessageBoxButtons.OK,\r\n            MessageBoxIcon.Information\r\n        )\r\n\r\n\r\n        # ====================================================\r\n        # 13. DYNAMO OUTPUT\r\n        # ====================================================\r\n\r\n        OUT = [\r\n            model_size,\r\n            model_elements,\r\n            model_warnings,\r\n            loaded_links,\r\n            results,\r\n            three_d_view.Name,\r\n            element_count\r\n        ]\r\n\r\n\r\nexcept Exception as e:\r\n\r\n    OUT = \"Error: \" + str(e)",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
