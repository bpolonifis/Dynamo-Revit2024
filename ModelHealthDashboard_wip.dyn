    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Windows.Forms import MessageBox, MessageBoxButtons, MessageBoxIcon\r\n\r\n\r\n# ============================================================\r\n# DOCUMENT\r\n# ============================================================\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc = DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\n\r\n\r\ntry:\r\n\r\n   \r\n    # ========================================================\r\n    # 2. CREATE / USE DEDICATED 3D VIEW\r\n    # ========================================================\r\n\r\n    view_name = \"_MODEL_STATISTICS_3D\"\r\n\r\n    three_d_view = None\r\n\r\n    existing_views = FilteredElementCollector(doc) \\\r\n        .OfClass(View3D) \\\r\n        .ToElements()\r\n\r\n    for v in existing_views:\r\n\r\n        if not v.IsTemplate and v.Name == view_name:\r\n            three_d_view = v\r\n            break\r\n\r\n    # ========================================================\r\n    # 3. CREATE 3D VIEW IF REQUIRED\r\n    # ========================================================\r\n\r\n    if three_d_view is None:\r\n\r\n        view_family_type = None\r\n\r\n        view_family_types = FilteredElementCollector(doc) \\\r\n            .OfClass(ViewFamilyType) \\\r\n            .ToElements()\r\n\r\n        for vft in view_family_types:\r\n\r\n            if vft.ViewFamily == ViewFamily.ThreeDimensional:\r\n                view_family_type = vft\r\n                break\r\n\r\n        if view_family_type is None:\r\n            raise Exception(\r\n                \"Could not find a 3D ViewFamilyType.\"\r\n            )\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n        three_d_view = View3D.CreateIsometric(\r\n            doc,\r\n            view_family_type.Id\r\n        )\r\n\r\n        three_d_view.Name = view_name\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    # ========================================================\r\n    # 4. REMOVE ALL VIEW FILTERS\r\n    # ========================================================\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    filter_ids = three_d_view.GetFilters()\r\n\r\n    for filter_id in filter_ids:\r\n\r\n        try:\r\n            three_d_view.RemoveFilter(filter_id)\r\n        except:\r\n            pass\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n \r\n    # ====================================================\r\n    # 13. DYNAMO OUTPUT\r\n    # ====================================================\r\n\r\n    OUT = [\r\n          \r\n            three_d_view.Name,\r\n        ]\r\n\r\n\r\nexcept Exception as e:\r\n\r\n    OUT = \"Error: \" + str(e)\r\n    \r\n    \r\nmessage = (\r\n        \"MODEL STATISTICS\\n\\n\"\r\n        + \"3D View:         \"\r\n        + three_d_view.Name\r\n    )\r\n\r\n\r\n    MessageBox.Show(\r\n        message,\r\n        \"Model Statistics\",\r\n        MessageBoxButtons.OK,\r\n        MessageBoxIcon.Information\r\n    )",
      "Engine": "IronPython2",
      "EngineName": "IronPython2",
      "VariableInputPorts": true,
