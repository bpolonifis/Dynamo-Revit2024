    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "# IN[0] = flat list of name STRINGS (use Flatten node if nested)\r\n# IN[1] = list of grid ELEMENTS (same length/order)\r\n\r\nnames = IN[0]  # Ensure flat: strings only!\r\ngrids = IN[1]\r\n\r\nfrom collections import OrderedDict  # Preserves first occurrence order\r\n\r\nseen = OrderedDict()\r\nduplicates = []\r\n\r\nfor i, name in enumerate(names):\r\n    if name in seen:\r\n        duplicates.append(grids[i])\r\n    else:\r\n        seen[name] = True  # str is hashable!\r\n\r\nOUT = duplicates  # Grids to delete (connect to Element.Delete)\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "1cd94c77907049418c7822966e53df33",
      "NodeType": "PythonScriptNode",
      "Inputs": [
