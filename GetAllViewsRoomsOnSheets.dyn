{
  "Uuid": "420002f1-7067-4d25-b925-3eb9cd50c9ba",
  "IsCustomNode": false,
  "Description": "",
  "Name": "GetAllViewsRoomsOnSheets",
  "ElementResolver": {
    "ResolutionMap": {}
  },
  "Inputs": [
    {
      "Id": "60353dc1148f4d9f85a841c4ab06a556",
      "Name": "Titleblock Types",
      "Type": "selection",
      "Type2": "dropdownSelection",
      "Value": "TSΟ-AR-Title Block_A0:TSO_AR_A0",
      "Description": "Allows you to select a titleblock type from your Revit file.",
      "SelectedIndex": 5
    }
  ],
  "Outputs": [
    {
      "Id": "9bdef0b29a1a4d67a70358be14995ca1",
      "Name": "Python Script 2",
      "Type": "unknown",
      "InitialValue": "",
      "Description": "Runs an embedded Python script."
    }
  ],
  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"System.Windows.Forms\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Windows.Forms import MessageBox\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ==================================================\r\n# INPUTS\r\n# ==================================================\r\n\r\nrooms = UnwrapElement(IN[0]) if IN[0] else []\r\n\r\ntitleBlockType = UnwrapElement(IN[1]) if IN[1] else None\r\n\r\nplanPoint = IN[2]\r\nnorthPoint = IN[3]\r\neastPoint = IN[4]\r\nsouthPoint = IN[5]\r\nwestPoint = IN[6]\r\n\r\nsheetPrefix = IN[7] if len(IN) > 7 and IN[7] else \"IE\"\r\n\r\n# ==================================================\r\n# HELPERS\r\n# ==================================================\r\n\r\ndef get_room_number(room):\r\n\r\n    try:\r\n        p = room.LookupParameter(\"Number\")\r\n        if p and p.HasValue:\r\n            return p.AsString()\r\n    except:\r\n        pass\r\n\r\n    return str(room.Id.IntegerValue)\r\n\r\n\r\ndef get_room_name(room):\r\n\r\n    try:\r\n        p = room.LookupParameter(\"Name\")\r\n        if p and p.HasValue:\r\n            return p.AsString()\r\n    except:\r\n        pass\r\n\r\n    return \"Unnamed\"\r\n\r\n\r\ndef get_room_title(room):\r\n\r\n    return \"{} - {}\".format(\r\n        get_room_number(room),\r\n        get_room_name(room)\r\n    )\r\n\r\n\r\ndef point_to_xyz(pt):\r\n\r\n    return XYZ(\r\n        pt.X,\r\n        pt.Y,\r\n        0\r\n    )\r\n\r\n\r\ndef sheet_exists(sheet_number):\r\n\r\n    sheets = FilteredElementCollector(doc)\\\r\n        .OfClass(ViewSheet)\r\n\r\n    for s in sheets:\r\n\r\n        try:\r\n            if s.SheetNumber.upper() == sheet_number.upper():\r\n                return True\r\n        except:\r\n            pass\r\n\r\n    return False\r\n\r\n\r\ndef find_room_views(room):\r\n\r\n    roomTitle = get_room_title(room)\r\n\r\n    plan = None\r\n    north = None\r\n    east = None\r\n    south = None\r\n    west = None\r\n\r\n    allViews = FilteredElementCollector(doc)\\\r\n        .OfClass(View)\r\n\r\n    for v in allViews:\r\n\r\n        try:\r\n\r\n            if v.IsTemplate:\r\n                continue\r\n\r\n            name = v.Name.upper()\r\n\r\n            if name == (\r\n                roomTitle + \" - PLAN\"\r\n            ).upper():\r\n\r\n                plan = v\r\n\r\n            elif name == (\r\n                roomTitle + \" - NORTH\"\r\n            ).upper():\r\n\r\n                north = v\r\n\r\n            elif name == (\r\n                roomTitle + \" - EAST\"\r\n            ).upper():\r\n\r\n                east = v\r\n\r\n            elif name == (\r\n                roomTitle + \" - SOUTH\"\r\n            ).upper():\r\n\r\n                south = v\r\n\r\n            elif name == (\r\n                roomTitle + \" - WEST\"\r\n            ).upper():\r\n\r\n                west = v\r\n\r\n        except:\r\n            pass\r\n\r\n    return plan, north, east, south, west\r\n\r\n\r\ndef set_project_browsing_view(element):\r\n\r\n    try:\r\n\r\n        p = element.LookupParameter(\r\n            \"Project Browsing Sheet Packge\"\r\n        )\r\n\r\n        if p and not p.IsReadOnly:\r\n            p.Set(\"ROOMS\")\r\n\r\n    except:\r\n        pass\r\n\r\n\r\n# ==================================================\r\n# VALIDATION\r\n# ==================================================\r\n\r\nif not rooms:\r\n\r\n    OUT = \"No rooms supplied.\"\r\n\r\nelif not titleBlockType:\r\n\r\n    OUT = \"No title block supplied.\"\r\n\r\nelse:\r\n\r\n    successCount = 0\r\n    skipCount = 0\r\n    failCount = 0\r\n\r\n    createdSheets = []\r\n    results = []\r\n\r\n    TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n    for room in rooms:\r\n\r\n        try:\r\n\r\n            roomTitle = get_room_title(room)\r\n            roomNumber = get_room_number(room)\r\n\r\n            sheetNumber = \"{}-{}\".format(\r\n                sheetPrefix,\r\n                roomNumber\r\n            )\r\n\r\n            # =====================================\r\n            # SHEET EXISTS?\r\n            # =====================================\r\n\r\n            if sheet_exists(sheetNumber):\r\n\r\n                skipCount += 1\r\n\r\n                results.append(\r\n                    \"SKIPPED : {} (Sheet exists)\"\r\n                    .format(sheetNumber)\r\n                )\r\n\r\n                continue\r\n\r\n            # =====================================\r\n            # FIND VIEWS\r\n            # =====================================\r\n\r\n            planView, northView, eastView, southView, westView = \\\r\n                find_room_views(room)\r\n\r\n            missing = []\r\n\r\n            if not planView:\r\n                missing.append(\"PLAN\")\r\n\r\n            if not northView:\r\n                missing.append(\"NORTH\")\r\n\r\n            if not eastView:\r\n                missing.append(\"EAST\")\r\n\r\n            if not southView:\r\n                missing.append(\"SOUTH\")\r\n\r\n            if not westView:\r\n                missing.append(\"WEST\")\r\n\r\n            if missing:\r\n\r\n                skipCount += 1\r\n\r\n                results.append(\r\n                    \"SKIPPED : {} (Missing {})\"\r\n                    .format(\r\n                        roomTitle,\r\n                        \", \".join(missing)\r\n                    )\r\n                )\r\n\r\n                continue\r\n\r\n            # =====================================\r\n            # CREATE SHEET\r\n            # =====================================\r\n\r\n            sheet = ViewSheet.Create(\r\n                doc,\r\n                titleBlockType.Id\r\n            )\r\n\r\n            sheet.SheetNumber = sheetNumber\r\n\r\n            sheet.Name = (\r\n                roomTitle +\r\n                \" Interior Elevations\"\r\n            )\r\n\r\n            set_project_browsing_view(sheet)\r\n\r\n            doc.Regenerate()\r\n\r\n            # =====================================\r\n            # PLAN\r\n            # =====================================\r\n\r\n            Viewport.Create(\r\n                doc,\r\n                sheet.Id,\r\n                planView.Id,\r\n                point_to_xyz(planPoint)\r\n            )\r\n\r\n            # =====================================\r\n            # NORTH\r\n            # =====================================\r\n\r\n            Viewport.Create(\r\n                doc,\r\n                sheet.Id,\r\n                northView.Id,\r\n                point_to_xyz(northPoint)\r\n            )\r\n\r\n            # =====================================\r\n            # EAST\r\n            # =====================================\r\n\r\n            Viewport.Create(\r\n                doc,\r\n                sheet.Id,\r\n                eastView.Id,\r\n                point_to_xyz(eastPoint)\r\n            )\r\n\r\n            # =====================================\r\n            # SOUTH\r\n            # =====================================\r\n\r\n            Viewport.Create(\r\n                doc,\r\n                sheet.Id,\r\n                southView.Id,\r\n                point_to_xyz(southPoint)\r\n            )\r\n\r\n            # =====================================\r\n            # WEST\r\n            # =====================================\r\n\r\n            Viewport.Create(\r\n                doc,\r\n                sheet.Id,\r\n                westView.Id,\r\n                point_to_xyz(westPoint)\r\n            )\r\n\r\n            doc.Regenerate()\r\n\r\n            createdSheets.append(sheet)\r\n\r\n            successCount += 1\r\n\r\n            results.append(\r\n                \"SUCCESS : {}\".format(sheetNumber)\r\n            )\r\n\r\n        except Exception as ex:\r\n\r\n            failCount += 1\r\n\r\n            results.append(\r\n                \"FAILED : {} --> {}\"\r\n                .format(\r\n                    get_room_title(room),\r\n                    str(ex)\r\n                )\r\n            )\r\n\r\n    TransactionManager.Instance.TransactionTaskDone()\r\n\r\n    # ==================================================\r\n    # SUMMARY\r\n    # ==================================================\r\n\r\n    summary = (\r\n        \"ROOM SHEET GENERATOR\\n\"\r\n        \"=====================================\\n\\n\"\r\n        \"Rooms Selected : {}\\n\"\r\n        \"Sheets Created : {}\\n\"\r\n        \"Skipped        : {}\\n\"\r\n        \"Failed         : {}\\n\\n\"\r\n        \"DETAILS\\n\"\r\n        \"-------------------------------------\\n{}\\n\"\r\n    ).format(\r\n        len(rooms),\r\n        successCount,\r\n        skipCount,\r\n        failCount,\r\n        \"\\n\".join(results)\r\n    )\r\n\r\n    try:\r\n\r\n        MessageBox.Show(\r\n            summary,\r\n            \"Room Sheet Generator\"\r\n        )\r\n\r\n    except:\r\n        pass\r\n\r\n    OUT = {\r\n        \"Sheets\": createdSheets,\r\n        \"Created\": successCount,\r\n        \"Skipped\": skipCount,\r\n        \"Failed\": failCount,\r\n        \"Details\": results\r\n    }",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "9bdef0b29a1a4d67a70358be14995ca1",
