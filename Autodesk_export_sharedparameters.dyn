  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport sys\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\nfrom Autodesk.Revit.DB.Structure import *\r\n\r\nclr.AddReference('RevitAPIUI')\r\nfrom Autodesk.Revit.UI import *\r\n\r\nclr.AddReference('System')\r\nimport System\r\nfrom System.Collections.Generic import List\r\nfrom System import Guid as Guid\r\nclr.AddReference('RevitNodes')\r\nimport Revit\r\nclr.ImportExtensions(Revit.GeometryConversion)\r\nclr.ImportExtensions(Revit.Elements)\r\n\r\nclr.AddReference('RevitServices')\r\nimport RevitServices\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\nuidoc=DocumentManager.Instance.CurrentUIApplication.ActiveUIDocument\r\nuiapp = DocumentManager.Instance.CurrentUIApplication\r\napp = uiapp.Application\r\n\r\n#Preparing input from dynamo to revit\r\nelement = UnwrapElement(IN[0])\r\n\r\n#Do some action in a Transaction\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\nparameters = FilteredElementCollector(doc).OfClass(SharedParameterElement).WhereElementIsNotElementType()\r\n\r\ndefinition_file = app.OpenSharedParameterFile()\r\ndefinition_groups = definition_file.Groups\r\n\r\n\r\ntry:\r\n    definition_groups.Create(\"Exported Parameters\")\r\nexcept Exception as e:\r\n    print(e)\r\n    \r\n\r\n\r\ndef export_shared_parameters(definition_groups):\r\n    exported_definitions = dict()\r\n    for i in definition_groups:\r\n        if i.Name != \"Exported Parameters\":\r\n            continue\r\n        names = [definition.Name for definition in i.Definitions]\r\n        for parameter in parameters:\r\n            if parameter.Name in names:\r\n                continue\r\n            definition = parameter.GetDefinition()\r\n            try:\r\n                options = ExternalDefinitionCreationOptions(parameter.Name, definition.GetDataType())\r\n            except Exception as e:\r\n                print(e)\r\n            options.GUID = parameter.GuidValue\r\n            try:\r\n                exported_definition = i.Definitions.Create(options)\r\n                exported_definitions[parameter.Name] = exported_definition\r\n            except Exception as e:\r\n                print(e)\r\n    return {\"Exported Definitions\": exported_definitions}\r\nOUT = export_shared_parameters(definition_groups)",
      "Engine": "CPython3",
      "VariableInputPorts": true,
