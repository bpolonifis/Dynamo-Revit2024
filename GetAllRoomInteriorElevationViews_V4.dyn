  "Nodes": [
    {
      "ConcreteType": "Dynamo.Graph.Nodes.CustomNodes.Function, DynamoCore",
      "FunctionSignature": "0f02572a-0625-4873-a564-a255a9c750c1",
      "FunctionType": "Graph",
      "Id": "16e9d80fcdb245cc99577242bc31ed29",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "0f866bedf3af463fb82b38cb931e789b",
          "Name": "docOrLink",
          "Description": "Uses current if none provided.\nAccepts document or link instance.\n\nvar[]..[]\nDefault value : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "04bdd772460947eb83be91dfa2e07c68",
          "Name": "valid",
          "Description": "All rooms validly placed in the model",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "54461eac20654a2a89163f1bce1403ed",
          "Name": "invalid",
          "Description": "All unplaced or unbound rooms",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Auto",
      "Description": "Collects all valid/invalid rooms as two lists. Invalid rooms are not placed, or have issues that make their area invalid (not enclosed, redundant etc.)."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "\r\nimport clr\r\n\r\n# ==================================================\r\n# REFERENCES\r\n# ==================================================\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nclr.AddReference(\"RevitServices\")\r\nclr.AddReference(\"System.Windows.Forms\")\r\n\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Windows.Forms import MessageBox\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# ==================================================\r\n# INPUTS\r\n# ==================================================\r\n\r\n# IN[0] = Rooms\r\n# IN[1] = Elevation View Family Type\r\n# IN[2] = View Scale (optional)\r\n\r\nrooms = UnwrapElement(IN[0]) if IN[0] else []\r\nviewFamilyType = UnwrapElement(IN[1]) if IN[1] else None\r\nviewScale = IN[2] if len(IN) > 2 and IN[2] else 50\r\n\r\n# ==================================================\r\n# HELPERS\r\n# ==================================================\r\n\r\ndef get_room_title(room):\r\n\r\n    room_num = \"\"\r\n    room_name = \"\"\r\n\r\n    try:\r\n        p = room.LookupParameter(\"Number\")\r\n        if p and p.HasValue:\r\n            room_num = p.AsString()\r\n    except:\r\n        pass\r\n\r\n    try:\r\n        p = room.LookupParameter(\"Name\")\r\n        if p and p.HasValue:\r\n            room_name = p.AsString()\r\n    except:\r\n        pass\r\n\r\n    if room_num and room_name:\r\n        return \"{} - {}\".format(room_num, room_name)\r\n\r\n    elif room_num:\r\n        return room_num\r\n\r\n    elif room_name:\r\n        return room_name\r\n\r\n    return \"Unnamed Room\"\r\n\r\n\r\ndef get_room_center(room):\r\n\r\n    bbox = room.get_BoundingBox(None)\r\n\r\n    if not bbox:\r\n        return None\r\n\r\n    try:\r\n        z = room.Location.Point.Z\r\n    except:\r\n        z = (bbox.Min.Z + bbox.Max.Z) / 2.0\r\n\r\n    return XYZ(\r\n        (bbox.Min.X + bbox.Max.X) / 2.0,\r\n        (bbox.Min.Y + bbox.Max.Y) / 2.0,\r\n        z\r\n    )\r\n\r\n\r\ndef get_room_dimensions(room):\r\n\r\n    bbox = room.get_BoundingBox(None)\r\n\r\n    if not bbox:\r\n        return None\r\n\r\n    width = abs(bbox.Max.X - bbox.Min.X)\r\n    depth = abs(bbox.Max.Y - bbox.Min.Y)\r\n    height = abs(bbox.Max.Z - bbox.Min.Z)\r\n\r\n    if height < 8:\r\n        height = 10.0\r\n\r\n    return width, depth, height\r\n\r\n\r\ndef view_exists(view_name):\r\n\r\n    views = FilteredElementCollector(doc)\\\r\n        .OfClass(View)\r\n\r\n    for v in views:\r\n\r\n        try:\r\n            if v.Name.upper() == view_name.upper():\r\n                return True\r\n        except:\r\n            pass\r\n\r\n    return False\r\n    \r\n### Set Project Browsing View parameter as ROOMS    \r\ndef set_project_browsing_view(view):\r\n\r\n    try:\r\n\r\n        p = view.LookupParameter(\r\n            \"Project Browsing View\"\r\n        )\r\n\r\n        if p and not p.IsReadOnly:\r\n\r\n            p.Set(\"ROOMS\")\r\n\r\n    except:\r\n        pass\r\n\r\n# ==================================================\r\n# VALIDATION\r\n# ==================================================\r\n\r\nif not rooms:\r\n\r\n    OUT = \"No rooms supplied.\"\r\n\r\nelif not viewFamilyType:\r\n\r\n    OUT = \"No Elevation ViewFamilyType supplied.\"\r\n\r\nelif not isinstance(doc.ActiveView, ViewPlan):\r\n\r\n    OUT = \"Run script from a Floor Plan view.\"\r\n\r\nelse:\r\n\r\n    sourcePlan = doc.ActiveView\r\n\r\n    if sourcePlan.IsTemplate:\r\n\r\n        OUT = \"Active View cannot be a View Template.\"\r\n\r\n    else:\r\n\r\n        activeLevelId = sourcePlan.GenLevel.Id\r\n\r\n        results = []\r\n        created_views = []\r\n\r\n        success_count = 0\r\n        fail_count = 0\r\n        skipped_count = 0\r\n\r\n        total_elevations = 0\r\n        plan_count = 0\r\n\r\n        suffixes = [\"NORTH\", \"EAST\", \"SOUTH\", \"WEST\"]\r\n\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n        for room in rooms:\r\n\r\n            try:\r\n\r\n                room_title = get_room_title(room)\r\n\r\n                # =====================================\r\n                # LEVEL FILTER\r\n                # =====================================\r\n\r\n                if room.LevelId != activeLevelId:\r\n\r\n                    skipped_count += 1\r\n\r\n                    results.append(\r\n                        \"SKIPPED : {} (Different Level)\"\r\n                        .format(room_title)\r\n                    )\r\n\r\n                    continue\r\n\r\n                center = get_room_center(room)\r\n\r\n                if not center:\r\n\r\n                    fail_count += 1\r\n\r\n                    results.append(\r\n                        \"FAILED : {} (No center point)\"\r\n                        .format(room_title)\r\n                    )\r\n\r\n                    continue\r\n\r\n                dims = get_room_dimensions(room)\r\n\r\n                if not dims:\r\n\r\n                    fail_count += 1\r\n\r\n                    results.append(\r\n                        \"FAILED : {} (No room dimensions)\"\r\n                        .format(room_title)\r\n                    )\r\n\r\n                    continue\r\n\r\n                room_width, room_depth, room_height = dims\r\n\r\n                # =====================================\r\n                # CREATE ROOM PLAN\r\n                # =====================================\r\n\r\n                planName = room_title + \" - PLAN\"\r\n\r\n                roomPlan = None\r\n\r\n                if view_exists(planName):\r\n\r\n                    results.append(\r\n                        \"PLAN EXISTS : {}\".format(planName)\r\n                    )\r\n\r\n                else:\r\n\r\n                    duplicatedId = sourcePlan.Duplicate(\r\n                        ViewDuplicateOption.Duplicate\r\n                    )\r\n\r\n                    roomPlan = doc.GetElement(\r\n                        duplicatedId\r\n                    )\r\n\r\n                    try:\r\n                        roomPlan.Name = planName\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n                        roomPlan.Scale = int(viewScale)\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n\r\n                        bbox = room.get_BoundingBox(None)\r\n\r\n                        offset = 2.0\r\n\r\n                        crop = roomPlan.CropBox\r\n\r\n                        crop.Min = XYZ(\r\n                            bbox.Min.X - offset,\r\n                            bbox.Min.Y - offset,\r\n                            crop.Min.Z\r\n                        )\r\n\r\n                        crop.Max = XYZ(\r\n                            bbox.Max.X + offset,\r\n                            bbox.Max.Y + offset,\r\n                            crop.Max.Z\r\n                        )\r\n\r\n                        roomPlan.CropBox = crop\r\n                        roomPlan.CropBoxActive = True\r\n                        roomPlan.CropBoxVisible = False\r\n\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n                        comments = roomPlan.LookupParameter(\"Comments\")\r\n                        if comments:\r\n                            comments.Set(\r\n                                str(room.Id.IntegerValue)\r\n                            )\r\n                    except:\r\n                        pass\r\n\r\n                    created_views.append(roomPlan)\r\n                    ###\r\n                    set_project_browsing_view(roomPlan)\r\n                    \r\n                    plan_count += 1\r\n\r\n                doc.Regenerate()\r\n\r\n                # =====================================\r\n                # CREATE ELEVATION MARKER\r\n                # =====================================\r\n\r\n                marker = ElevationMarker.CreateElevationMarker(\r\n                    doc,\r\n                    viewFamilyType.Id,\r\n                    center,\r\n                    5.0\r\n                )\r\n\r\n                doc.Regenerate()\r\n\r\n                # =====================================\r\n                # CREATE ELEVATIONS\r\n                # =====================================\r\n\r\n                for idx in range(4):\r\n\r\n                    elevName = \"{} - {}\".format(\r\n                        room_title,\r\n                        suffixes[idx]\r\n                    )\r\n\r\n                    if view_exists(elevName):\r\n\r\n                        continue\r\n\r\n                    elev = marker.CreateElevation(\r\n                        doc,\r\n                        sourcePlan.Id,\r\n                        idx\r\n                    )\r\n\r\n                    doc.Regenerate()\r\n\r\n                    try:\r\n                        elev.Name = elevName\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n                        elev.Scale = int(viewScale)\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n                        elev.CropBoxActive = True\r\n                        elev.CropBoxVisible = False\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n\r\n                        if idx in [0, 2]:\r\n                            far_depth = room_depth * 1.2\r\n                        else:\r\n                            far_depth = room_width * 1.2\r\n\r\n                        far_clip = elev.get_Parameter(\r\n                            BuiltInParameter.VIEWER_BOUND_OFFSET_FAR\r\n                        )\r\n\r\n                        if far_clip and not far_clip.IsReadOnly:\r\n                            far_clip.Set(far_depth)\r\n\r\n                    except:\r\n                        pass\r\n\r\n                    try:\r\n                        comments = elev.LookupParameter(\"Comments\")\r\n                        if comments:\r\n                            comments.Set(\r\n                                str(room.Id.IntegerValue)\r\n                            )\r\n                    except:\r\n                        pass\r\n\r\n                    created_views.append(elev)\r\n                    \r\n                    ###\r\n                    set_project_browsing_view(elev)\r\n\r\n                    total_elevations += 1\r\n\r\n                    doc.Regenerate()\r\n\r\n                success_count += 1\r\n\r\n                results.append(\r\n                    \"SUCCESS : {} (Plan + Elevations)\"\r\n                    .format(room_title)\r\n                )\r\n\r\n            except Exception as ex:\r\n\r\n                fail_count += 1\r\n\r\n                try:\r\n                    room_name = get_room_title(room)\r\n                except:\r\n                    room_name = \"Unknown Room\"\r\n\r\n                results.append(\r\n                    \"FAILED : {} --> {}\"\r\n                    .format(\r\n                        room_name,\r\n                        str(ex)\r\n                    )\r\n                )\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        # =============================================\r\n        # SUMMARY\r\n        # =============================================\r\n\r\n        activeLevelName = \"\"\r\n\r\n        try:\r\n            activeLevelName = sourcePlan.GenLevel.Name\r\n        except:\r\n            activeLevelName = \"Unknown\"\r\n\r\n        summary = (\r\n            \"ROOM VIEW GENERATOR\\n\"\r\n            \"=====================================\\n\\n\"\r\n            \"Active Level  : {}\\n\\n\"\r\n            \"Rooms Selected: {}\\n\"\r\n            \"Successful    : {}\\n\"\r\n            \"Skipped       : {}\\n\"\r\n            \"Failed        : {}\\n\\n\"\r\n            \"Plans Created : {}\\n\"\r\n            \"Elevations    : {}\\n\\n\"\r\n            \"DETAILS\\n\"\r\n            \"-------------------------------------\\n{}\\n\"\r\n        ).format(\r\n            activeLevelName,\r\n            len(rooms),\r\n            success_count,\r\n            skipped_count,\r\n            fail_count,\r\n            plan_count,\r\n            total_elevations,\r\n            \"\\n\".join(results)\r\n        )\r\n\r\n        try:\r\n\r\n            MessageBox.Show(\r\n                summary,\r\n                \"Room View Generator\"\r\n            )\r\n\r\n        except:\r\n            pass\r\n\r\n        OUT = {\r\n            \"Views\": created_views,\r\n            \"Rooms Selected\": len(rooms),\r\n            \"Successful\": success_count,\r\n            \"Skipped\": skipped_count,\r\n            \"Failed\": fail_count,\r\n            \"Plans Created\": plan_count,\r\n            \"Elevations Created\": total_elevations,\r\n            \"Details\": results\r\n        }\r\n",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "dba7516c6c90479cbfe5f2a8fa3e15c9",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "95f42e36727b418888d6f90ef59daebf",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
