  "Nodes": [
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import os\r\nfrom Autodesk.Revit.DB import *\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\nfrom System.Windows.Forms import MessageBox, MessageBoxButtons, MessageBoxIcon\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\ntry:\r\n    file_path = doc.PathName\r\n\r\n    if file_path and file_path != \"\" and file_path != \"<Internal>\":\r\n        file_size_mb = os.path.getsize(file_path) / (1024 * 1024)\r\n        model_size = str(round(file_size_mb, 2)) + \" MB\"\r\n    else:\r\n        model_size = \"Document not saved\"\r\n\r\n    element_count = FilteredElementCollector(doc).GetElementCount()#\r\n    #element_count = len(\r\n    #FilteredElementCollector(doc)\r\n    #.WhereElementIsNotElementType()\r\n    #.ToElements())\r\n    model_elements = str(element_count) + \" elements\"\r\n    \r\n    warning_count = len(doc.GetWarnings())\r\n    model_warnings = str(warning_count) + \" warnings\"\r\n    \r\n    link_count = FilteredElementCollector(doc).OfClass(RevitLinkInstance).GetElementCount()\r\n    loaded_links = str(link_count) + \" links\"\r\n\r\n    pi = FilteredElementCollector(doc).OfCategory(BuiltInCategory.OST_ProjectInformation).FirstElement()\r\n\r\n    if pi is None:\r\n        OUT = \"Project Information element not found.\"\r\n    else:\r\n        TransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\n        results = []\r\n        for pname, pvalue in [\r\n            (\"Model Size\", model_size),\r\n            (\"Model Elements\", model_elements),\r\n            (\"Model Warnings\", model_warnings),\r\n            (\"Loaded Links\", loaded_links)\r\n        ]:\r\n            p = pi.LookupParameter(pname)\r\n            if p and not p.IsReadOnly:\r\n                ok = p.Set(pvalue)\r\n                results.append(pname + \": \" + str(ok))\r\n            else:\r\n                results.append(pname + \": not found or read-only\")\r\n\r\n        TransactionManager.Instance.TransactionTaskDone()\r\n\r\n        message = \"MODEL STATISTICS\\n\\n\" + \\\r\n                  \"Model Size:     \" + model_size + \"\\n\" + \\\r\n                  \"Model Elements: \" + model_elements + \"\\n\" + \\\r\n                  \"Model Warnings: \" + model_warnings + \"\\n\" + \\\r\n                  \"Loaded Links:   \" + loaded_links + \"\\n\\n\" + \\\r\n                  \"Write results:\\n\" + \"\\n\".join(results)\r\n\r\n        MessageBox.Show(message, \"Model Statistics\", MessageBoxButtons.OK, MessageBoxIcon.Information)\r\n        OUT = [model_size, model_elements, model_warnings, loaded_links, results]\r\n\r\nexcept Exception as e:\r\n    OUT = \"Error: \" + str(e)",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
