  "Nodes": [
    {
      "ConcreteType": "DSRevitNodesUI.Categories, DSRevitNodesUI",
      "SelectedIndex": 76,
      "SelectedString": "OST_Assemblies",
      "Id": "13736c80ad73400ca98e966e90d39a35",
      "NodeType": "ExtensionNode",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "c4715ac2921941058da9825b6d2939a7",
          "Name": "Category",
          "Description": "The selected Category.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "All built-in categories."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\n\r\n# Revit API\r\nclr.AddReference('RevitAPI')\r\nfrom Autodesk.Revit.DB import *\r\n\r\n# Revit Services\r\nclr.AddReference('RevitServices')\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\n# Current document\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# Inputs\r\nassemblies = UnwrapElement(IN[0])\r\nparamName = IN[1]\r\n\r\nupdated = []\r\nerrors = []\r\n\r\n# Start Transaction\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor assembly in assemblies:\r\n\r\n    try:\r\n\r\n        # Ensure object is AssemblyInstance\r\n        if isinstance(assembly, AssemblyInstance):\r\n\r\n            # Get source parameter from assembly\r\n            sourceParam = assembly.LookupParameter(paramName)\r\n\r\n            if sourceParam:\r\n\r\n                # Read parameter value\r\n                value = sourceParam.AsString()\r\n\r\n                # Skip empty values\r\n                if value:\r\n\r\n                    # Get all member element IDs\r\n                    memberIds = assembly.GetMemberIds()\r\n\r\n                    for memberId in memberIds:\r\n\r\n                        elem = doc.GetElement(memberId)\r\n\r\n                        if elem:\r\n\r\n                            # Find target parameter\r\n                            targetParam = elem.LookupParameter(paramName)\r\n\r\n                            # Ensure parameter exists and is writable\r\n                            if targetParam and not targetParam.IsReadOnly:\r\n\r\n                                # Handle parameter storage types\r\n                                if targetParam.StorageType == StorageType.String:\r\n                                    targetParam.Set(value)\r\n\r\n                                updated.append(elem.Id.IntegerValue)\r\n\r\n    except Exception as ex:\r\n\r\n        errors.append(str(ex))\r\n\r\n# End Transaction\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n# Output\r\nOUT = (updated, errors)",
      "Engine": "CPython3",
      "EngineName": "CPython3",
      "VariableInputPorts": true,
      "Id": "2012d7297ef443688680da301298de20",
      "NodeType": "PythonScriptNode",
      "Inputs": [
